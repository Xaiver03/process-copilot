{
  "name": "process-copilot",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --parallel --if-present dev",
    "build": "pnpm --recursive --if-present build",
    "test": "pnpm --recursive --if-present test",
    "lint": "pnpm --recursive --if-present lint",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "lint:contracts": "pnpm --package=@redocly/cli@1.34.5 dlx redocly lint packages/contracts/openapi.yaml"
  }
}
