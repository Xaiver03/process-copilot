{
  "name": "process-copilot",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --parallel --if-present dev",
    "build": "pnpm --recursive --if-present build",
    "test": "pnpm --recursive --if-present test",
    "lint": "pnpm --recursive --if-present lint",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "lint:contracts": "pnpm --package=@redocly/cli@1.34.5 dlx redocly lint packages/contracts/openapi.yaml",
    "test:e2e:journeys": "playwright test -c tests/e2e/playwright.config.ts && node tests/e2e/build-journey-manifest.mjs --target \"${PLAYWRIGHT_EVIDENCE_TARGET:-local}\" --base-url \"${PLAYWRIGHT_BASE_URL:-http://127.0.0.1:18092}\" ${PLAYWRIGHT_SOURCE_COMMIT:+--source-commit \"$PLAYWRIGHT_SOURCE_COMMIT\"}"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0"
  }
}
