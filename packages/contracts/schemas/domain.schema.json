{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wuno.ai/process-copilot/domain.schema.json",
  "title": "Process Copilot Domain Contract",
  "$defs": {
    "Scenario": {
      "type": "object",
      "required": ["id", "name", "faultId", "sampleCount", "faultOnsetSample", "sourceLabel"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "description": {"type": ["string", "null"]},
        "faultId": {"type": "integer", "minimum": 0, "maximum": 21},
        "sampleCount": {"type": "integer", "minimum": 1},
        "faultOnsetSample": {"type": "integer", "minimum": 0},
        "sourceLabel": {"const": "Tennessee Eastman Process public simulation"}
      },
      "additionalProperties": false
    },
    "ReplayRun": {
      "type": "object",
      "required": ["id", "scenarioId", "state", "speed", "currentSample", "createdAt", "inferenceMode", "modelVersion"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "scenarioId": {"type": "string"},
        "state": {"enum": ["ready", "playing", "paused", "completed", "failed"]},
        "speed": {"type": "number"},
        "currentSample": {"type": "integer", "minimum": 0},
        "createdAt": {"type": "string", "format": "date-time"},
        "inferenceMode": {"type": "string", "enum": ["online", "template"]},
        "modelVersion": {"type": "string"}
      },
      "additionalProperties": false
    },
    "FaultCandidate": {
      "type": "object",
      "required": ["faultId", "label", "probability"],
      "properties": {
        "faultId": {"type": "integer", "minimum": 0, "maximum": 21},
        "label": {"type": "string"},
        "probability": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "EvidenceItem": {
      "type": "object",
      "required": ["variableId", "variableName", "unit", "contribution", "direction", "summary", "values"],
      "properties": {
        "variableId": {"type": "string", "pattern": "^(XMEAS|XMV)\\([0-9]+\\)$"},
        "variableName": {"type": "string"},
        "unit": {"type": "string"},
        "contribution": {"type": "number", "minimum": 0},
        "direction": {"enum": ["up", "down", "mixed"]},
        "summary": {"type": "string"},
        "values": {
          "type": "array",
          "items": {"type": "number"}
        }
      },
      "additionalProperties": false
    },
    "Recommendation": {
      "type": "object",
      "required": ["mode", "risk", "checks", "actions", "safetyBoundary"],
      "properties": {
        "mode": {"enum": ["template", "llm_enhanced", "degraded"]},
        "risk": {"type": "string"},
        "checks": {"type": "array", "items": {"type": "string"}},
        "actions": {"type": "array", "items": {"type": "string"}},
        "safetyBoundary": {"const": "Read-only advice. No automatic control write-back."}
      },
      "additionalProperties": false
    },
    "EventDetail": {
      "type": "object",
      "required": [
        "id", "runId", "sampleIndex", "severity", "state", "anomalyScore",
        "detectionSample", "diagnosisSample", "diagnosisDelaySamples",
        "diagnosisState", "diagnosisAnomalyScore", "anomalyLatched",
        "initialCandidates", "candidates", "evidence", "recommendation",
        "modelVersion", "dataSourceDisclosure"
      ],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "runId": {"type": "string", "format": "uuid"},
        "sampleIndex": {"type": "integer", "minimum": 0},
        "severity": {"enum": ["warning", "critical"]},
        "state": {"enum": ["open", "confirmed", "rejected", "escalated"]},
        "anomalyScore": {"type": "number"},
        "detectionSample": {"type": "integer", "minimum": 0},
        "diagnosisSample": {"type": "integer", "minimum": 0},
        "diagnosisDelaySamples": {"const": 20},
        "diagnosisState": {"enum": ["pending", "provisional", "updated"]},
        "diagnosisAnomalyScore": {"type": "number"},
        "anomalyLatched": {"const": true},
        "initialCandidates": {
          "type": "array",
          "maxItems": 3,
          "items": {"$ref": "#/$defs/FaultCandidate"}
        },
        "candidates": {
          "type": "array",
          "maxItems": 3,
          "items": {"$ref": "#/$defs/FaultCandidate"}
        },
        "evidence": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/EvidenceItem"}
        },
        "recommendation": {"$ref": "#/$defs/Recommendation"},
        "modelVersion": {"type": "string"},
        "dataSourceDisclosure": {"const": "Public simulation data, not real Guizhou plant data."}
      },
      "additionalProperties": false
    },
    "InferenceSnapshot": {
      "type": "object",
      "required": ["runId", "sampleIndex", "t2", "spe", "anomalyScore", "alarmState", "modelVersion", "latencyMs"],
      "properties": {
        "runId": {"type": "string", "format": "uuid"},
        "sampleIndex": {"type": "integer", "minimum": 0},
        "t2": {"type": "number"},
        "spe": {"type": "number"},
        "anomalyScore": {"type": "number"},
        "alarmState": {"type": "string", "enum": ["normal", "warning", "critical"]},
        "modelVersion": {"type": "string"},
        "latencyMs": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "SSEMessage": {
      "type": "object",
      "required": ["type", "sequence", "runId", "emittedAt"],
      "properties": {
        "type": {"type": "string", "enum": ["state", "inference", "anomaly_opened", "diagnosis_updated", "completed", "failed", "heartbeat"]},
        "sequence": {"type": "integer", "minimum": 0},
        "runId": {"type": "string", "format": "uuid"},
        "emittedAt": {"type": "string", "format": "date-time"},
        "sampleIndex": {"type": "integer", "minimum": 0},
        "state": {"enum": ["ready", "playing", "paused", "completed", "failed"]},
        "inference": {"$ref": "#/$defs/InferenceSnapshot"},
        "eventId": {"type": "string", "format": "uuid"},
        "diagnosisState": {"enum": ["pending", "provisional", "updated"]},
        "message": {"type": "string"},
        "errorCode": {"type": "string"}
      },
      "additionalProperties": false
    },
    "AskEventRequest": {
      "type": "object",
      "required": ["question"],
      "properties": {
        "question": {"type": "string", "minLength": 1, "maxLength": 500}
      },
      "additionalProperties": false
    },
    "AIAnswer": {
      "type": "object",
      "required": ["answer", "mode", "model", "evidenceRefs", "latencyMs", "traceId"],
      "properties": {
        "answer": {"type": "string"},
        "mode": {"type": "string", "enum": ["llm_enhanced", "template", "degraded"]},
        "model": {"type": "string"},
        "evidenceRefs": {"type": "array", "items": {"type": "string"}},
        "latencyMs": {"type": "number", "minimum": 0},
        "traceId": {"type": "string"}
      },
      "additionalProperties": false
    },
    "ServiceStatus": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"type": "string", "enum": ["ready", "degraded", "offline", "unknown"]},
        "version": {"type": "string"},
        "latencyMs": {"type": "number", "minimum": 0},
        "reason": {"type": "string"}
      },
      "additionalProperties": false
    },
    "AIStatus": {
      "type": "object",
      "required": ["inferenceMode", "worker", "industrialModel", "languageModel", "dataBuildHash"],
      "properties": {
        "inferenceMode": {"type": "string", "enum": ["online", "template"]},
        "worker": {"$ref": "#/$defs/ServiceStatus"},
        "industrialModel": {"$ref": "#/$defs/ServiceStatus"},
        "languageModel": {"$ref": "#/$defs/ServiceStatus"},
        "dataBuildHash": {"type": "string"}
      },
      "additionalProperties": false
    },
    "AIInteraction": {
      "type": "object",
      "required": ["id", "eventId", "question", "answer", "mode", "model", "evidenceRefs", "latencyMs", "traceId", "createdAt"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "eventId": {"type": "string", "format": "uuid"},
        "question": {"type": "string"},
        "answer": {"type": "string"},
        "mode": {"type": "string", "enum": ["llm_enhanced", "template", "degraded"]},
        "model": {"type": "string"},
        "evidenceRefs": {"type": "array", "items": {"type": "string"}},
        "latencyMs": {"type": "number", "minimum": 0},
        "traceId": {"type": "string"},
        "createdAt": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "AdminOverview": {
      "type": "object",
      "required": ["inferenceMode", "worker", "industrialModel", "languageModel", "dataBuildHash", "recentLLMCalls", "degradedReasons"],
      "properties": {
        "inferenceMode": {"type": "string", "enum": ["online", "template"]},
        "worker": {"$ref": "#/$defs/ServiceStatus"},
        "industrialModel": {"$ref": "#/$defs/ServiceStatus"},
        "languageModel": {"$ref": "#/$defs/ServiceStatus"},
        "dataBuildHash": {"type": "string"},
        "recentLLMCalls": {"type": "array", "items": {"$ref": "#/$defs/AIInteraction"}},
        "degradedReasons": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "AIConfig": {
      "type": "object",
      "required": ["provider", "baseUrl", "model", "enabled", "timeoutMs", "maxTokens", "temperature", "promptVersion", "fallbackPolicy", "apiKeyConfigured", "version"],
      "properties": {
        "provider": {"type": "string"},
        "baseUrl": {"type": "string", "format": "uri"},
        "model": {"type": "string"},
        "enabled": {"type": "boolean"},
        "timeoutMs": {"type": "integer", "minimum": 1, "maximum": 120000},
        "maxTokens": {"type": "integer", "minimum": 1, "maximum": 32768},
        "temperature": {"type": "number", "minimum": 0, "maximum": 2},
        "promptVersion": {"type": "string"},
        "fallbackPolicy": {"type": "string", "enum": ["template", "degraded"]},
        "apiKeyConfigured": {"type": "boolean"},
        "version": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "UpdateAIConfigRequest": {
      "type": "object",
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "baseUrl": {"type": "string", "format": "uri"},
        "model": {"type": "string", "minLength": 1},
        "enabled": {"type": "boolean"},
        "timeoutMs": {"type": "integer", "minimum": 1, "maximum": 120000},
        "maxTokens": {"type": "integer", "minimum": 1, "maximum": 32768},
        "temperature": {"type": "number", "minimum": 0, "maximum": 2},
        "promptVersion": {"type": "string", "minLength": 1},
        "fallbackPolicy": {"type": "string", "enum": ["template", "degraded"]},
        "apiKey": {"type": "string", "minLength": 1, "writeOnly": true},
        "clearApiKey": {"type": "boolean", "default": false},
        "expectedVersion": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "AIConnectionTestRequest": {
      "type": "object",
      "properties": {
        "question": {"type": "string", "minLength": 1, "maxLength": 500}
      },
      "additionalProperties": false
    },
    "AIConnectionTestResponse": {
      "type": "object",
      "required": ["ok", "mode", "provider", "model", "latencyMs", "traceId"],
      "properties": {
        "ok": {"type": "boolean"},
        "mode": {"type": "string", "enum": ["llm_enhanced", "degraded"]},
        "provider": {"type": "string"},
        "model": {"type": "string"},
        "latencyMs": {"type": "number", "minimum": 0},
        "traceId": {"type": "string"},
        "error": {"type": "string"}
      },
      "additionalProperties": false
    },
    "AIInteractionPage": {
      "type": "object",
      "required": ["items", "total"],
      "properties": {
        "items": {"type": "array", "items": {"$ref": "#/$defs/AIInteraction"}},
        "total": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "AdminAuditEntry": {
      "type": "object",
      "required": ["id", "actor", "action", "resourceType", "resourceId", "createdAt", "traceId", "requestId", "changeSummary"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "actor": {"type": "string"},
        "action": {"type": "string"},
        "resourceType": {"type": "string"},
        "resourceId": {"type": "string"},
        "createdAt": {"type": "string", "format": "date-time"},
        "traceId": {"type": "string"},
        "requestId": {"type": "string"},
        "changeSummary": {
          "type": "object",
          "required": ["changedFields", "previousVersion", "currentVersion"],
          "properties": {
            "changedFields": {"type": "array", "items": {"type": "string"}},
            "previousVersion": {"type": "string"},
            "currentVersion": {"type": "string"},
            "apiKeyChanged": {"type": "boolean"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "AdminAuditPage": {
      "type": "object",
      "required": ["items", "total"],
      "properties": {
        "items": {"type": "array", "items": {"$ref": "#/$defs/AdminAuditEntry"}},
        "total": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "CreateControlProposalRequest": {
      "type": "object",
      "required": ["actionDraft"],
      "properties": {
        "actionDraft": {"type": "string", "minLength": 1, "maxLength": 2000},
        "sourceTraceId": {"type": ["string", "null"], "maxLength": 128}
      },
      "additionalProperties": false
    },
    "ControlCheck": {
      "type": "object",
      "required": ["name", "status", "detail"],
      "properties": {
        "name": {"type": "string"},
        "status": {"enum": ["passed", "not_configured", "not_connected", "disabled"]},
        "detail": {"type": "string"}
      },
      "additionalProperties": false
    },
    "ControlProposal": {
      "type": "object",
      "required": ["id", "eventId", "actionDraft", "executionMode", "state", "checks", "requestedBy", "sent", "traceId", "createdAt"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "eventId": {"type": "string", "format": "uuid"},
        "actionDraft": {"type": "string"},
        "sourceTraceId": {"type": ["string", "null"]},
        "executionMode": {"enum": ["shadow"]},
        "state": {"enum": ["blocked_demo_boundary"]},
        "checks": {"type": "array", "items": {"$ref": "#/$defs/ControlCheck"}},
        "requestedBy": {"type": "string"},
        "sent": {"type": "boolean", "enum": [false]},
        "traceId": {"type": "string"},
        "createdAt": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "Decision": {
      "type": "object",
      "required": ["decision", "operatorName", "note"],
      "properties": {
        "decision": {"enum": ["confirm", "reject", "escalate"]},
        "operatorName": {"type": "string", "minLength": 1, "maxLength": 80},
        "note": {"type": "string", "maxLength": 1000}
      },
      "additionalProperties": false
    },
    "DecisionRecord": {
      "type": "object",
      "required": ["id", "eventId", "decision", "operatorName", "note", "createdAt", "modelVersion", "traceId"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "eventId": {"type": "string", "format": "uuid"},
        "decision": {"enum": ["confirm", "reject", "escalate"]},
        "operatorName": {"type": "string"},
        "note": {"type": "string"},
        "createdAt": {"type": "string", "format": "date-time"},
        "modelVersion": {"type": "string"},
        "traceId": {"type": "string"}
      },
      "additionalProperties": false
    },
    "EnvironmentalVariable": {
      "type": "object",
      "required": ["variableId", "variableName", "unit", "monitoringPoint", "leadingIndicator"],
      "properties": {
        "variableId": {"type": "string"},
        "variableName": {"type": "string"},
        "unit": {"type": "string"},
        "monitoringPoint": {"type": "string"},
        "leadingIndicator": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "EnvironmentalCitation": {
      "type": "object",
      "required": ["label", "detail"],
      "properties": {
        "label": {"type": "string"},
        "detail": {"type": "string"}
      },
      "additionalProperties": false
    },
    "EnvironmentalScenario": {
      "type": "object",
      "required": ["id", "name", "description", "monitoringPoints", "regulatoryLimitLabel", "regulatoryLimitValue", "regulatoryLimitUnit", "variables", "sourceLabel", "citations"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "description": {"type": "string"},
        "monitoringPoints": {"type": "array", "items": {"type": "string"}},
        "regulatoryLimitLabel": {"type": "string"},
        "regulatoryLimitValue": {"type": "number"},
        "regulatoryLimitUnit": {"type": "string"},
        "variables": {"type": "array", "items": {"$ref": "#/$defs/EnvironmentalVariable"}},
        "sourceLabel": {"type": "string"},
        "citations": {"type": "array", "items": {"$ref": "#/$defs/EnvironmentalCitation"}}
      },
      "additionalProperties": false
    },
    "EnvironmentalTelemetrySeries": {
      "type": "object",
      "required": ["variableId", "values"],
      "properties": {
        "variableId": {"type": "string"},
        "values": {"type": "array", "items": {"type": "number"}}
      },
      "additionalProperties": false
    },
    "EnvironmentalEarlyWarning": {
      "type": "object",
      "required": ["triggered", "breachVariableId", "summary"],
      "properties": {
        "triggered": {"type": "boolean"},
        "warningDay": {"type": ["integer", "null"]},
        "warningVariableId": {"type": ["string", "null"]},
        "breachDay": {"type": ["integer", "null"]},
        "breachVariableId": {"type": "string"},
        "leadTimeDays": {"type": ["integer", "null"]},
        "summary": {"type": "string"}
      },
      "additionalProperties": false
    },
    "EnvironmentalScenarioDetail": {
      "type": "object",
      "required": ["scenario", "dayIndex", "series", "earlyWarning"],
      "properties": {
        "scenario": {"$ref": "#/$defs/EnvironmentalScenario"},
        "dayIndex": {"type": "array", "items": {"type": "integer"}},
        "series": {"type": "array", "items": {"$ref": "#/$defs/EnvironmentalTelemetrySeries"}},
        "earlyWarning": {"$ref": "#/$defs/EnvironmentalEarlyWarning"}
      },
      "additionalProperties": false
    },
    "CapacityLineRequest": {
      "type": "object",
      "required": ["id", "name", "requestedP2o5Tpd"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 64},
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "requestedP2o5Tpd": {"type": "number", "exclusiveMinimum": 0},
        "priority": {"type": "integer", "minimum": 0, "maximum": 10, "default": 0}
      },
      "additionalProperties": false
    },
    "CapacityPlanRequest": {
      "type": "object",
      "required": ["gypsumCapTpd", "lines"],
      "properties": {
        "gypsumCapTpd": {"type": "number", "exclusiveMinimum": 0},
        "gypsumRatioLow": {"type": "number", "exclusiveMinimum": 0, "default": 4.0},
        "gypsumRatioHigh": {"type": "number", "exclusiveMinimum": 0, "default": 5.0},
        "lines": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/CapacityLineRequest"}}
      },
      "additionalProperties": false
    },
    "CapacityLineResult": {
      "type": "object",
      "required": ["id", "name", "requestedP2o5Tpd", "allocatedP2o5Tpd", "loadPctOfRequest"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "requestedP2o5Tpd": {"type": "number"},
        "allocatedP2o5Tpd": {"type": "number"},
        "loadPctOfRequest": {"type": "number"}
      },
      "additionalProperties": false
    },
    "CapacityPlanOption": {
      "type": "object",
      "required": ["strategy", "label", "totalAllocatedP2o5Tpd", "gypsumOutputLowTpd", "gypsumOutputHighTpd", "withinCap", "utilizationPct", "lines"],
      "properties": {
        "strategy": {"enum": ["proportional", "priority_first", "equal_share"]},
        "label": {"type": "string"},
        "totalAllocatedP2o5Tpd": {"type": "number"},
        "gypsumOutputLowTpd": {"type": "number"},
        "gypsumOutputHighTpd": {"type": "number"},
        "withinCap": {"type": "boolean"},
        "utilizationPct": {"type": "number"},
        "lines": {"type": "array", "items": {"$ref": "#/$defs/CapacityLineResult"}}
      },
      "additionalProperties": false
    },
    "CapacityPlanResponse": {
      "type": "object",
      "required": ["gypsumCapTpd", "totalRequestedP2o5Tpd", "requestedGypsumOutputLowTpd", "requestedGypsumOutputHighTpd", "requestWithinCap", "options", "disclosure"],
      "properties": {
        "gypsumCapTpd": {"type": "number"},
        "totalRequestedP2o5Tpd": {"type": "number"},
        "requestedGypsumOutputLowTpd": {"type": "number"},
        "requestedGypsumOutputHighTpd": {"type": "number"},
        "requestWithinCap": {"type": "boolean"},
        "options": {"type": "array", "items": {"$ref": "#/$defs/CapacityPlanOption"}},
        "disclosure": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
